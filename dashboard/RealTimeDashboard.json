      "id": "05a48a69-93af-7ab1-7bec-e157a4bc0d8d"
    },
    {
      "name": "Zapasy i zuzycie",
      "id": "1b89f944-2291-60ff-d5b2-7439f1767e23"
    },
    {
      "name": "Drogi i dostepnosc",
      "id": "eed92aeb-b8c0-f994-bb28-9d409d4491ae"
    }
  ],
  "queries": [
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "8f5bfc44-808a-5d2f-316f-493b1e3961d3"
      },
      "text": "TransportTracking\n| where timestamp between (_startTime .. _endTime)\n| summarize arg_max(timestamp, lat, lon, speed_kmh, status, delay_min, allocation_id) by transport_id\n| project transport_id, lat, lon, Opoznienie = delay_min, Predkosc = speed_kmh, status, allocation_id",
      "id": "c61181c1-21b0-c840-180b-7fa19c051f52",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "8f5bfc44-808a-5d2f-316f-493b1e3961d3"
      },
      "text": "let okno = TransportTracking | where timestamp between (_startTime .. _endTime);\nlet transporty = okno | summarize arg_max(timestamp, status, delay_min) by transport_id;\nlet zapotrzebowanie = Demand | where timestamp between (_startTime .. _endTime);\nlet punkty = ShelterOccupancy | where timestamp between (_startTime .. _endTime)\n    | summarize arg_max(timestamp, occupied, capacity) by shelter_id;\nunion\n  (transporty | summarize Wskaznik = 'Transporty w ruchu', Wartosc = countif(status == 'in_transit')),\n  (transporty | summarize Wskaznik = 'Transporty opoznione', Wartosc = countif(delay_min > 30)),\n  (zapotrzebowanie | summarize Wskaznik = 'Nowe zapotrzebowania', Wartosc = count()),\n  (zapotrzebowanie | summarize Wskaznik = 'W tym priorytet 1', Wartosc = countif(priority == 1)),\n  (punkty | summarize Wskaznik = 'Osoby w punktach', Wartosc = sum(occupied)),\n  (punkty | summarize Wskaznik = 'Punkty powyzej 90%', Wartosc = countif(capacity > 0 and todouble(occupied) / capacity > 0.9))",
      "id": "3f26eee1-9f8f-8482-45c4-a8fd3c38c288",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "8f5bfc44-808a-5d2f-316f-493b1e3961d3"
      },
      "text": "Demand\n| where timestamp between (_startTime .. _endTime)\n| summarize Priorytet1 = countif(priority == 1), Priorytet2 = countif(priority == 2), Priorytet3 = countif(priority >= 3)\n    by Czas = bin(timestamp, 1m)\n| order by Czas asc",
      "id": "b8610491-66bd-7c86-29a4-1b64d93092af",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "8f5bfc44-808a-5d2f-316f-493b1e3961d3"
      },
      "text": "Demand\n| where timestamp between (_startTime .. _endTime)\n| summarize Sztuk = sum(quantity), Zgloszenia = count() by voivodeship_code\n| join kind=inner (dim_voivodeship | project voivodeship_code, voivodeship_name) on voivodeship_code\n| project Wojewodztwo = voivodeship_name, Sztuk, Zgloszenia\n| order by Sztuk desc\n| take 16",
      "id": "50adfe15-bc9d-51b2-4da1-49e5b6bcf2fb",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "8f5bfc44-808a-5d2f-316f-493b1e3961d3"
      },
      "text": "Demand\n| where timestamp between (_startTime .. _endTime)\n| where priority == 1\n| join kind=leftouter (Allocation | project demand_id, allocation_id, status) on demand_id\n| where isempty(allocation_id) or status != 'delivered'\n| join kind=leftouter (dim_gmina | project gmina_code, gmina_name) on gmina_code\n| join kind=leftouter (dim_resource_type | project resource_type_id, resource_name) on resource_type_id\n| project Zgloszono = timestamp, Gmina = gmina_name, Zasob = resource_name, Sztuk = quantity,\n          Stan = iff(isempty(allocation_id), 'bez przydzialu', status), Uzasadnienie = justification\n| order by Zgloszono desc\n| take 40",
      "id": "f7a04452-31c1-de0e-a390-c28a01575c68",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "8f5bfc44-808a-5d2f-316f-493b1e3961d3"
      },
      "text": "TransportTracking\n| where timestamp between (_startTime .. _endTime)\n| summarize SrednieOpoznienieMin = round(avg(delay_min), 1), MaksymalneOpoznienieMin = max(delay_min)\n    by Czas = bin(timestamp, 1m)\n| order by Czas asc",
      "id": "478c5813-b83b-8cde-84ee-35fc83514bc8",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "8f5bfc44-808a-5d2f-316f-493b1e3961d3"
      },
      "text": "TransportTracking\n| where timestamp between (_startTime .. _endTime)\n| summarize arg_max(timestamp, delay_min, status, eta, allocation_id) by transport_id\n| where delay_min > 0\n| top 12 by delay_min desc\n| project Transport = transport_id, Opoznienie = delay_min, status, eta",
      "id": "52af2f52-843c-87b3-e180-d934e3516611",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "8f5bfc44-808a-5d2f-316f-493b1e3961d3"
      },
      "text": "TransportTracking\n| where timestamp between (_startTime .. _endTime)\n| summarize arg_max(timestamp, status) by transport_id\n| summarize Transporty = count() by Status = status",
      "id": "a986b366-e37e-adda-05b4-7e25027be0ca",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "8f5bfc44-808a-5d2f-316f-493b1e3961d3"
      },
      "text": "TransportTracking\n| where timestamp between (_startTime .. _endTime)\n| summarize SredniaPredkosc = round(avg(speed_kmh), 1), Postoje = countif(speed_kmh < 5)\n    by Czas = bin(timestamp, 1m)\n| order by Czas asc",
      "id": "34839f2a-9064-ee45-b703-c291c3fbb092",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "8f5bfc44-808a-5d2f-316f-493b1e3961d3"
      },
      "text": "let stan = ShelterOccupancy\n    | where timestamp between (_startTime .. _endTime)\n    | summarize arg_max(timestamp, occupied, capacity, medical_care_required) by shelter_id;\nunion\n  (stan | summarize Wskaznik = 'Osoby w punktach', Wartosc = sum(occupied)),\n  (stan | summarize Wskaznik = 'Miejsca wolne', Wartosc = sum(capacity) - sum(occupied)),\n  (stan | summarize Wskaznik = 'Wymagajacy opieki medycznej', Wartosc = sum(medical_care_required)),\n  (stan | summarize Wskaznik = 'Punkty powyzej 90%', Wartosc = countif(capacity > 0 and todouble(occupied) / capacity > 0.9))",
      "id": "1e5e9d05-c1f7-059e-4201-929064b837c7",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "8f5bfc44-808a-5d2f-316f-493b1e3961d3"
      },
      "text": "ShelterOccupancy\n| where timestamp between (_startTime .. _endTime)\n| summarize Osoby = sum(occupied), Pojemnosc = sum(capacity) by Czas = bin(timestamp, 1m)\n| extend OblozenieProc = round(100.0 * Osoby / Pojemnosc, 1)\n| order by Czas asc",
      "id": "59ce4ede-07dc-438d-52f2-75f6f279d587",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "8f5bfc44-808a-5d2f-316f-493b1e3961d3"
      },
      "text": "ShelterOccupancy\n| where timestamp between (_startTime .. _endTime)\n| summarize arg_max(timestamp, occupied, capacity, medical_care_required) by shelter_id\n| join kind=inner (dim_shelter | project shelter_id, shelter_name, lat, lon) on shelter_id\n| project shelter_id, shelter_name, lat, lon, Osoby = occupied,\n          OblozenieProc = round(100.0 * occupied / capacity, 1), Medyczne = medical_care_required",
      "id": "acb3c4fe-12cf-9db2-1d36-a2e7e78ddada",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "8f5bfc44-808a-5d2f-316f-493b1e3961d3"
      },
      "text": "ShelterOccupancy\n| where timestamp between (_startTime .. _endTime)\n| summarize arg_max(timestamp, occupied, capacity, medical_care_required) by shelter_id\n| where capacity > 0 and todouble(occupied) / capacity > 0.85\n| join kind=inner (dim_shelter | project shelter_id, shelter_name, gmina_code) on shelter_id\n| join kind=leftouter (dim_gmina | project gmina_code, gmina_name) on gmina_code\n| project Punkt = shelter_name, Gmina = gmina_name, Osoby = occupied, Pojemnosc = capacity,\n          OblozenieProc = round(100.0 * occupied / capacity, 1), Medyczne = medical_care_required\n| order by OblozenieProc desc\n| take 40",
      "id": "939255ff-2e4d-fc3d-dffc-c18cce19c38a",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "8f5bfc44-808a-5d2f-316f-493b1e3961d3"
      },
      "text": "Consumption\n| where timestamp between (_startTime .. _endTime)\n| summarize Zuzycie = sum(consumed_qty) by Czas = bin(timestamp, 1m)\n| order by Czas asc",
      "id": "b23e8866-4f3b-9e6e-cdbc-c76b60654852",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "8f5bfc44-808a-5d2f-316f-493b1e3961d3"
      },
      "text": "Consumption\n| where timestamp between (_startTime .. _endTime)\n| summarize Zuzycie = sum(consumed_qty) by resource_type_id\n| join kind=inner (dim_resource_type | project resource_type_id, category) on resource_type_id\n| summarize Zuzycie = sum(Zuzycie) by Kategoria = category\n| order by Zuzycie desc",
      "id": "84afbd9f-e12e-6033-e09e-0c37307d0e13",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "8f5bfc44-808a-5d2f-316f-493b1e3961d3"
      },
      "text": "StockSnapshot\n| summarize arg_max(snapshot_date, available_qty, reserved_qty, in_transit_qty) by warehouse_id, resource_type_id\n| join kind=inner (dim_resource_type | project resource_type_id, category) on resource_type_id\n| summarize Dostepne = sum(available_qty), Zarezerwowane = sum(reserved_qty), WDrodze = sum(in_transit_qty)\n    by Kategoria = category\n| order by Dostepne desc",
      "id": "765bf762-1708-badd-a282-650644f17482",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "8f5bfc44-808a-5d2f-316f-493b1e3961d3"
      },
      "text": "let zuzycie_okno = Consumption\n    | where timestamp between (_startTime .. _endTime)\n    | summarize Zuzycie = sum(consumed_qty) by resource_type_id;\nStockSnapshot\n| summarize arg_max(snapshot_date, available_qty) by warehouse_id, resource_type_id\n| summarize Dostepne = sum(available_qty) by resource_type_id\n| join kind=inner zuzycie_okno on resource_type_id\n| join kind=inner (dim_resource_type | project resource_type_id, resource_name, unit) on resource_type_id\n| extend DniZapasu = round(todouble(Dostepne) / iff(Zuzycie > 0, todouble(Zuzycie), 1.0), 1)\n| project Zasob = resource_name, Jednostka = unit, Dostepne, ZuzycieWOknie = Zuzycie, DniZapasu\n| order by DniZapasu asc\n| take 20",
      "id": "b8ecd113-10a0-475e-51de-2e5eb3c74004",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "8f5bfc44-808a-5d2f-316f-493b1e3961d3"
      },
      "text": "RoadStatus\n| where timestamp <= _endTime\n| summarize arg_max(timestamp, status, reason, lat, lon, road_name, voivodeship_code) by road_segment_id\n| where status != 'przejezdna'\n| extend Waga = iff(status == 'nieprzejezdna', 3, 1)\n| project road_segment_id, road_name, lat, lon, status, reason, Waga",
      "id": "047c2b32-f53a-5c40-f706-175c5f9a0d17",
      "usedVariables": [
        "_endTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "8f5bfc44-808a-5d2f-316f-493b1e3961d3"
      },
      "text": "RoadStatus\n| where timestamp <= _endTime\n| summarize arg_max(timestamp, status, voivodeship_code) by road_segment_id\n| summarize Odcinki = count() by voivodeship_code, Status = status\n| join kind=inner (dim_voivodeship | project voivodeship_code, voivodeship_name) on voivodeship_code\n| project Wojewodztwo = voivodeship_name, Status, Odcinki\n| order by Odcinki desc",
      "id": "28841b8c-3d80-e5b1-872a-c9fcbb22c354",
      "usedVariables": [
        "_endTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "8f5bfc44-808a-5d2f-316f-493b1e3961d3"
      },
      "text": "RoadStatus\n| where timestamp <= _endTime\n| summarize arg_max(timestamp, status, reason, road_name, voivodeship_code) by road_segment_id\n| where status == 'nieprzejezdna'\n| join kind=leftouter (dim_voivodeship | project voivodeship_code, voivodeship_name) on voivodeship_code\n| project Odcinek = road_name, Wojewodztwo = voivodeship_name, Przyczyna = reason, Od = timestamp\n| order by Od desc\n| take 30",
      "id": "fd6f2c81-a593-e8cd-a933-cc5d0b43f625",
      "usedVariables": [
        "_endTime"
      ]
    }
  ]
}