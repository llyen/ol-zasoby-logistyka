table fact_allocation
	sourceLineageTag: [dbo].[fact_allocation]

	column allocated_qty
		dataType: int64
		formatString: 0
		sourceLineageTag: allocated_qty
		summarizeBy: sum
		sourceColumn: allocated_qty

	column allocation_id
		dataType: string
		sourceLineageTag: allocation_id
		summarizeBy: none
		sourceColumn: allocation_id

	column decision_level
		dataType: string
		sourceLineageTag: decision_level
		summarizeBy: none
		sourceColumn: decision_level

	column demand_id
		dataType: string
		sourceLineageTag: demand_id
		summarizeBy: none
		sourceColumn: demand_id

	column eta
		dataType: dateTime
		sourceLineageTag: eta
		summarizeBy: none
		sourceColumn: eta

	column status
		dataType: string
		sourceLineageTag: status
		summarizeBy: none
		sourceColumn: status

	column transport_unit_id
		dataType: string
		sourceLineageTag: transport_unit_id
		summarizeBy: none
		sourceColumn: transport_unit_id

	column warehouse_id
		dataType: string
		sourceLineageTag: warehouse_id
		summarizeBy: none
		sourceColumn: warehouse_id

	column ingested_at
		dataType: dateTime
		sourceLineageTag: ingested_at
		summarizeBy: none
		sourceColumn: ingested_at

	partition fact_allocation = entity
		mode: directLake
		source
			entityName: fact_allocation
			expressionSource: 'DirectLake - OL_LOG_Lakehouse'
