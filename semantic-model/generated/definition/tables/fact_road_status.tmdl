		sourceColumn: reason

	column road_name
		dataType: string
		sourceLineageTag: road_name
		summarizeBy: none
		sourceColumn: road_name

	column road_segment_id
		dataType: string
		sourceLineageTag: road_segment_id
		summarizeBy: none
		sourceColumn: road_segment_id

	column status
		dataType: string
		sourceLineageTag: status
		summarizeBy: none
