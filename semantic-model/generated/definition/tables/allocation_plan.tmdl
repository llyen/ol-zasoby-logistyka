table allocation_plan
	sourceLineageTag: [dbo].[allocation_plan]

	column demand_id
		dataType: string
		sourceLineageTag: demand_id
		summarizeBy: none
		sourceColumn: demand_id

	column priority
		dataType: int64
		formatString: 0
		sourceLineageTag: priority
		summarizeBy: sum
		sourceColumn: priority

	column resource_type_id
		dataType: string
		sourceLineageTag: resource_type_id
		summarizeBy: none
		sourceColumn: resource_type_id

	column warehouse_id
		dataType: string
		sourceLineageTag: warehouse_id
		summarizeBy: none
		sourceColumn: warehouse_id

	column gmina_code
		dataType: string
		sourceLineageTag: gmina_code
		summarizeBy: none
		sourceColumn: gmina_code

	column voivodeship_code
		dataType: string
		sourceLineageTag: voivodeship_code
		summarizeBy: none
		sourceColumn: voivodeship_code

	column allocated_qty
		dataType: int64
		formatString: 0
		sourceLineageTag: allocated_qty
		summarizeBy: sum
		sourceColumn: allocated_qty

	column travel_time_h
		dataType: double
		sourceLineageTag: travel_time_h
		summarizeBy: sum
		sourceColumn: travel_time_h

	column method
		dataType: string
		sourceLineageTag: method
		summarizeBy: none
		sourceColumn: method

	partition allocation_plan = entity
		mode: directLake
		source
			entityName: allocation_plan
			expressionSource: 'DirectLake - OL_LOG_Lakehouse'
