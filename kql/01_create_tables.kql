// OL Logistics - Eventhouse schema and ingestion mappings
.create-merge table TransportTracking (transport_id:string, allocation_id:string, timestamp:datetime, lat:real, lon:real, speed_kmh:real, eta:datetime, status:string, delay_min:int)
.create-merge table ShelterOccupancy (shelter_id:string, timestamp:datetime, capacity:int, occupied:int, medical_care_required:int)
.create-merge table Demand (demand_id:string, timestamp:datetime, day_label:string, gmina_code:string, powiat_code:string, voivodeship_code:string, resource_type_id:string, quantity:int, priority:int, justification:string, reported_by:string)
.create-merge table Allocation (allocation_id:string, demand_id:string, warehouse_id:string, allocated_qty:int, transport_unit_id:string, eta:datetime, status:string, decision_level:string)
.create-merge table RoadStatus (road_segment_id:string, voivodeship_code:string, road_name:string, status:string, reason:string, lat:real, lon:real, timestamp:datetime)
.create-merge table Consumption (site_id:string, timestamp:datetime, resource_type_id:string, consumed_qty:int, voivodeship_code:string)
.create-merge table RawEvents (timestamp:datetime, _stream:string, payload:dynamic)
.create-or-alter table TransportTracking ingestion json mapping "TransportTrackingMapping" '[{"column":"transport_id","path":"$.transport_id"},{"column":"allocation_id","path":"$.allocation_id"},{"column":"timestamp","path":"$.timestamp"},{"column":"lat","path":"$.lat"},{"column":"lon","path":"$.lon"},{"column":"speed_kmh","path":"$.speed_kmh"},{"column":"eta","path":"$.eta"},{"column":"status","path":"$.status"},{"column":"delay_min","path":"$.delay_min"}]'
.create-or-alter table ShelterOccupancy ingestion json mapping "ShelterOccupancyMapping" '[{"column":"shelter_id","path":"$.shelter_id"},{"column":"timestamp","path":"$.timestamp"},{"column":"capacity","path":"$.capacity"},{"column":"occupied","path":"$.occupied"},{"column":"medical_care_required","path":"$.medical_care_required"}]'
.create-or-alter table Demand ingestion json mapping "DemandMapping" '[{"column":"demand_id","path":"$.demand_id"},{"column":"timestamp","path":"$.timestamp"},{"column":"day_label","path":"$.day_label"},{"column":"gmina_code","path":"$.gmina_code"},{"column":"powiat_code","path":"$.powiat_code"},{"column":"voivodeship_code","path":"$.voivodeship_code"},{"column":"resource_type_id","path":"$.resource_type_id"},{"column":"quantity","path":"$.quantity"},{"column":"priority","path":"$.priority"},{"column":"justification","path":"$.justification"},{"column":"reported_by","path":"$.reported_by"}]'
